# ---- Server ----
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://githunguripresbytaryyouthsummit.co.ke

# ---- Database (Postgres — Supabase or Neon) ----
# Pick ONE of the two options below. If DATABASE_URL is set, it's used and
# the DB_* vars are ignored.
#
# OPTION A — DATABASE_URL (recommended for Neon, also works for Supabase)
#   Neon: dashboard → your project → Connection Details → copy the
#   "Connection string". Use the POOLED string (host contains "-pooler")
#   if you're deploying to a serverless platform (Vercel functions, Lambda,
#   etc.) that opens many short-lived connections; use the direct
#   (non-pooled) string for a normal long-running server (Render, Railway,
#   a VPS) — that's what this app expects by default.
#     DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require
#
# OPTION B — split vars (how Supabase's dashboard presents connection info)
#   Supabase dashboard → Project Settings → Database → Connection info.
#
#   Direct connection (recommended):
#     DB_HOST=db.<your-project-ref>.supabase.co
#     DB_PORT=5432
#     DB_USER=postgres
#
#   Transaction pooler (only if you specifically need it — see note in
#   backend/config/database.js):
#     DB_HOST=aws-0-<region>.pooler.supabase.com
#     DB_PORT=6543
#     DB_USER=postgres.<your-project-ref>
#
#   DB_NAME is "postgres" by default on Supabase unless you renamed it.
#   DB_PASSWORD is the database password you set when creating the project
#   (Project Settings → Database → Reset database password if you don't have it).
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
# Both Supabase and Neon require SSL — leave this true unless DATABASE_URL
# points at a local/self-hosted Postgres.
DB_SSL=true

# ---- JWT auth ----
# Generate with: openssl rand -hex 32
# (No OpenSSL on Windows? Run in PowerShell:
#  -join ((48..57)+(97..102)|Get-Random -Count 64|%{[char]$_}) )
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- TEMPORARY: skip OTP verification on self-registration ----
# Only needed while email/SMS delivery isn't actually configured yet
# (otherwise nobody could receive the code to verify their account).
# When "true", new registrations are verified immediately and logged
# straight in — no OTP screen, no code sent. Remove this var (or set it
# to anything other than "true") once BREVO_API_KEY/CELCOM_API_KEY are
# both working — normal OTP verification resumes automatically, no
# other change needed.
SKIP_OTP_VERIFICATION=false

# ---- M-Pesa Daraja ----
# https://developer.safaricom.co.ke — create an app under "Lipa Na M-Pesa Online"
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS URL (Render URL in production, ngrok for local testing)
MPESA_CALLBACK_URL=

# ---- Admission QR signing ----
# Generate the same way as JWT_SECRET. NEVER rotate this after registrations begin —
# it invalidates every already-issued admission QR code.
ADMISSION_QR_SECRET=

# ---- Google Sign-In (optional — login only, not registration) ----
# https://console.cloud.google.com/apis/credentials → Create Credentials
# → OAuth client ID → Web application. Add your frontend URL (both the
# Vercel URL and http://localhost for local testing) under "Authorized
# JavaScript origins" — NOT "Authorized redirect URIs", this flow doesn't
# redirect. This is the OAuth Client ID (ends in .apps.googleusercontent.com),
# not a client secret — the frontend needs to know this value too (see
# frontend/assets/js/config.js).
GOOGLE_CLIENT_ID=

# ---- Supabase Storage (gallery + profile photo + signature/logo uploads) ----
# From your Supabase project dashboard: Settings → API.
#   SUPABASE_URL           = "Project URL" (e.g. https://xxxxx.supabase.co)
#                             — NOT the same as DATABASE_URL above.
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" secret key (Settings → API →
#                             Project API keys). Server-side only — never
#                             send this to the browser.
# One-time setup in the Supabase dashboard: Storage → New bucket → name it
# to match SUPABASE_STORAGE_BUCKET below → toggle "Public bucket" on (so
# uploaded photos are viewable without another signed request).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gy-summit-2026

# ---- Email notifications (Announcements > Notification Channels) ----
# https://app.brevo.com → Settings (SMTP & API) → API Keys — the same
# BREVO_API_KEY also powers WhatsApp below, so if you've already set
# that up for WhatsApp you're most of the way there for email too.
# Also add and verify a sender under Senders, Domains & Dedicated IPs →
# Senders → Add a sender (click the confirmation link Brevo emails you —
# no DNS/domain ownership required for this) before senderEmail (set in
# the admin panel, NOT here — Announcements > Notification Channels >
# Sender Email) will actually deliver; an unverified sender fails the
# request. Full domain authentication (DKIM/DMARC) is optional and only
# improves deliverability at higher volume.
BREVO_API_KEY=

# ---- SMS notifications (Announcements > Notification Channels) ----
# Celcom Africa (isms.celcomafrica.com) — a Kenya-market SMS gateway.
# Get CELCOM_API_KEY and CELCOM_PARTNER_ID from your Celcom Africa
# account dashboard ("GET API KEY & PARTNER ID"). CELCOM_SHORTCODE is
# your sender ID/shortcode — needs to be registered and approved with
# Celcom before it will deliver under your own name rather than a
# shared default.
CELCOM_API_KEY=
CELCOM_PARTNER_ID=
CELCOM_SHORTCODE=INFOTEXT

# ---- WhatsApp notifications (optional — Brevo Transactional WhatsApp) ----
# Uses the same BREVO_API_KEY set under Email notifications above —
# nothing new to add here except the sender number below. SMS is the
# only channel on a separate provider (Celcom, above).

# Additional one-time setup in the Brevo dashboard: top nav → "Add more
# apps" → enable WhatsApp, then link a Facebook/WhatsApp Business account
# (see https://developers.brevo.com/docs/whatsapp-messages).
# BREVO_WHATSAPP_SENDER is that WhatsApp Business number, digits only
# with country code (e.g. 254712345678).
# BREVO_WHATSAPP_TEMPLATE_ID is optional: WhatsApp requires an
# approved message template for the first message to a new contact (or any
# message outside a 24-hour session) — leave blank to send plain text,
# which only works for participants who've messaged your WhatsApp number
# first, or set this once you've created and approved a template under
# Campaigns > WhatsApp in Brevo.
BREVO_WHATSAPP_SENDER=
BREVO_WHATSAPP_TEMPLATE_ID=

# ---- Ticket pricing (KES) ----
# Single ticket type — no Early Bird / VIP / gate pricing tiers.
TICKET_PRICE=1900

# ---- First admin account (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_PHONE=
